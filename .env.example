# Copy to .env and fill in real values. NEVER commit .env.
# Get a key at https://console.anthropic.com

# Required — the server refuses to start without this.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port to listen on (optional; defaults to 3000).
PORT=3000

# ── Rep tool auth (Phase 4) ──────────────────────────────────────────────
# Shared password reps type on the login page. Pick something strong.
# The server refuses to start if this is unset.
REP_PASSWORD=change-me-to-a-strong-shared-password

# Secret used to sign the login session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# How long a rep login stays valid, in hours (optional; default 12).
SESSION_TTL_HOURS=12

# ── Feature flags ────────────────────────────────────────────────────────
# The owner concierge widget still runs on MOCK data. Off by default for a
# rep-only go-live. Set to "true" only if you intentionally want it exposed.
OWNER_WIDGET_ENABLED=false
